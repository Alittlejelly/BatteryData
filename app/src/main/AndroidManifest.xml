<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 记录一次完整充电需要长时间后台采样，用前台服务挂着，通知栏常驻 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 开机时若正插着电（或有没记完的会话），自动恢复前台服务 / 超级岛 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 起，记录中的充电会升级成「实时更新」（状态栏胶囊 + 进度卡）。
         这是个普通权限，装包即授予；用户仍可在系统设置里单独关掉本应用的实时更新，
         关掉后会退回普通常驻通知。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- 应用内更新：下载完 APK 后拉起系统安装器。Android 8 起还需要用户在
         「安装未知应用」里给本应用授权，没授权时安装会被系统拦下。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 实时电量悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 记录模式 + 岛模式（充电门控保活）共用这一个前台服务，见类注释 -->
        <service
            android:name=".data.ChargeRecordService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="battery_charge_telemetry" />
        </service>

        <!--
          开机自动复活：BOOT_COMPLETED 是豁免隐式广播，进程被杀后开机仍能收到。
          ACTION_POWER_CONNECTED 不在豁免清单里（targetSdk 26+ 清单收不到），插电复活
          改由下面的充电约束 JobScheduler job 负责；这里保留它仅作个别厂商放行的兜底。
        -->
        <receiver
            android:name=".data.PowerEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          插电自动复活：充电约束 job 由系统持久化调度，进程被杀后系统仍会重排拉起，
          插电时执行 onStartJob 挂上岛模式前台服务。必须带 BIND_JOB_SERVICE 权限。
        -->
        <service
            android:name=".data.ChargeKeepAliveJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 实时电量悬浮窗 -->
        <service
            android:name=".data.BatteryOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="battery_overlay" />
        </service>

        <!--
          给小米小部件（主题格式）读数据的只读接口。
          exported 必须为 true：小部件跑在桌面/主题引擎进程里，是另一个 uid。
          不设 permission：桌面组件的 ContentProviderBinder 不会带我们的自定义权限，
          设了权限小部件就永远查不到数据。里面只有电池读数和充电统计，没有隐私内容。
        -->
        <provider
            android:name=".provider.BatteryWidgetProvider"
            android:authorities="${applicationId}.widget"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- 把 cache/apk/ 下的安装包暴露成 content:// 给系统安装器（见 ApkUpdater） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku IPC 接入：超级岛通知借 Shizuku 高权限 bypass XMSF 网络限制 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
